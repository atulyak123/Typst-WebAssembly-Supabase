node_modules
.pnpm-store
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =====================================
# 🧪 TESTING FILES
# =====================================
coverage

# =====================================
